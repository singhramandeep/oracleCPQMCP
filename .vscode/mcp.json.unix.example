{
  "servers": {
    "oracle-cpq": {
      "type": "stdio",
      "command": "${workspaceFolder}/scripts/mcp-server.sh",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "CPQ_CUSTOMER_PROFILE": "mycompany",
        "CPQ_CONFIG_DIR": "${workspaceFolder}/.config",
        "CPQ_SCHEMA_INTEGRITY": "1"
      }
    }
  }
}
