# ==============================================================================
# Oracle CPQ Customer Configuration Template (LEGACY flat .env)
# Prefer .config/.profile.yaml.example → .config/<customer_id>.yaml
# Migrate with: python scripts/migrate_profile_yaml.py <customer_id>
# Duplicate this file only if you still need a flat .env profile.
# ==============================================================================

# Friendly display name of the customer
CUSTOMER_NAME=Acme Corporation

# ------------------------------------------------------------------------------
# Environment Base URLs (no trailing slash)
# ------------------------------------------------------------------------------
DEV_URL=https://acme-dev.bigmachines.com
TEST_URL=https://acme-test.bigmachines.com
PROD_URL=https://acme.bigmachines.com

# ------------------------------------------------------------------------------
# Basic Authentication Credentials (Integration User recommended)
# Primary credentials are required per environment. Add _1, _2, _3 for additional
# users in the same environment (each USERNAME suffix requires a matching PASSWORD).
# ------------------------------------------------------------------------------
DEV_USERNAME=integration_user
DEV_PASSWORD=DevSecretPassword123!
# DEV_USERNAME_1=readonly_user
# DEV_PASSWORD_1=DevReadOnlyPassword123!

TEST_USERNAME=integration_user
TEST_PASSWORD=TestSecretPassword123!
# TEST_USERNAME_1=readonly_user
# TEST_PASSWORD_1=TestReadOnlyPassword123!

PROD_USERNAME=read_only_admin
PROD_PASSWORD=ProdSecretPassword123!
# PROD_USERNAME_1=backup_admin
# PROD_PASSWORD_1=ProdBackupPassword123!

# ------------------------------------------------------------------------------
# Default Settings
# ------------------------------------------------------------------------------
# Active environment to use by default when this customer profile is selected (dev, test, or prod)
DEFAULT_ENVIRONMENT=dev

# REST API Version to target (default: v15, can be v16 or v17 depending on CPQ release)
REST_API_VERSION=v15

# Block all create/update/patch/delete operations when true (default). Set false to allow DML.
READ_ONLY=true

# Append timestamped CPQ API request traces (redacted curl + parameters) to
# logs/{profile}-{environment}.log (default true). Set false to disable.
# Override with host env CPQ_DEBUG_MODE. Optional CPQ_DEBUG_LOG_DIR overrides
# the logs directory (default: <repo>/logs).
DEBUG_MODE=true

# HTTP timeout in seconds for CPQ REST calls (default 60). Raise for large BML
# zip downloads. Host override: CPQ_HTTP_TIMEOUT (wins over this key). Range 5–3600.
# HTTP_TIMEOUT=300

# Append copy-paste refined prompt footer after CPQ tool use (default true if omitted).
# Set false to disable the footer.
REFINED_PROMPT=true

# Auto-save refined prompts to .prompts/saved_prompts.json after each CPQ task
# (example default true). When false, the agent asks whether to save this time and/or
# enable auto-save for future runs (writes this key via set_auto_save_refined_prompt).
AUTO_SAVE_REFINED_PROMPT=true

# Local data/{profile}/{env} snapshot policy for full collection caches
# (users/groups/bml/commerce/datatables). ask (default) = prompt when cache exists;
# prefer = use cache silently when present; never = always fetch from CPQ.
# Override with CPQ_LOCAL_DATA_POLICY. Writable via set_local_data_policy.
LOCAL_DATA_POLICY=ask

# After tabular chat answers, offer Excel/Word export (default ask).
# ask = offer_export_response; never = skip; always_excel = export_response_excel without asking.
# Override with CPQ_POST_RESPONSE_EXPORT. Writable via set_post_response_export /
# offer_export_response choices always_excel|never.
POST_RESPONSE_EXPORT=ask

# Optional override for the local snapshot root (default: <repo>/data)
# CPQ_LOCAL_DATA_DIR=

# Optional path for the saved refined-prompt library (default: .prompts/saved_prompts.json)
# CPQ_SAVED_PROMPTS_PATH=

# Host company login name for company-scoped APIs (Groups). Use _host for the host company.
COMPANY_LOGIN_NAME=_host

# Customer-specific knowledge markdown under knowledge/ (basename only).
# Shared knowledge/CPQBaseKnowledge.md is always loaded; this file is appended when set.
# Example: focalpoint.md → knowledge/focalpoint.md
CUSTOMER_KNOWLEDGE_FILE=acme.md

# ------------------------------------------------------------------------------
# Global Data Tables (defaults for get_datatable / smoke test)
# Prefer listing these in .config/<id>.catalog.yaml (data_tables). Flat keys still
# work when no catalog file exists. Pair each name with CUSTOM_DATA_TABLE_ALIAS[_N].
# ------------------------------------------------------------------------------
CUSTOM_DATA_TABLE_NAME=PricingMatrix
CUSTOM_DATA_TABLE_ALIAS=pricing matrix
# CUSTOM_DATA_TABLE_NAME_1=DiscountMatrix
# CUSTOM_DATA_TABLE_ALIAS_1=discount matrix

# ------------------------------------------------------------------------------
# Global Commerce Process Variables (for commerce / transaction tools)
# Prefer .config/<id>.catalog.yaml (commerce_processes). Flat keys still work when
# no catalog file exists. COMMERCE_PROCESS_ENABLED[_N] defaults to true.
# ------------------------------------------------------------------------------
COMMERCE_PROCESS_VAR_NAME=oraclecpqo_bmClone_2
COMMERCE_PROCESS_ALIAS=base commerce process
COMMERCE_PROCESS_ENABLED=true
# COMMERCE_PROCESS_VAR_NAME_1=other_process
# COMMERCE_PROCESS_ALIAS_1=secondary process
# COMMERCE_PROCESS_ENABLED_1=false

# ------------------------------------------------------------------------------
# Profile catalog (recommended for large sites)
# Bulky commerce lists, metrics descriptions, and product family → line → model
# trees belong in .config/<customer_id>.catalog.yaml (gitignored).
# Copy .config/.catalog.yaml.example, or migrate flat keys with:
#   python scripts/migrate_profile_catalog.py <customer_id>
# When the YAML file exists it wins for catalog sections; this .env keeps secrets.
# Flat PRODUCT_FAMILY_* / PRODUCT_LINE_* / MODEL_* / METRICS_* keys remain supported
# when no .catalog.yaml is present.
# ------------------------------------------------------------------------------
# METRICS_QUOTES=Total number of quotes
# METRICS_DISKSPACE=Disk space used
