from __future__ import annotations

from typing import Any

from pydantic import Field

from oracle_cpq_mcp.core.cpq_client import CPQClient
from oracle_cpq_mcp.core.pagination import build_page_params, enrich_pagination_hint
from oracle_cpq_mcp.registry.tool_registry import TOOL_CATALOG  # after you add the spec
from oracle_cpq_mcp.security.validation import _StrictModel
from oracle_cpq_mcp.tools._register import register_tool


# ---------------------------------------------------------------------------
# 1) security/validation.py — input model
# ---------------------------------------------------------------------------
class ListWidgetsInput(_StrictModel):
    limit: int = Field(
        default=100,
        ge=1,
        le=1000,
        description="Page size (1–1000). Clamped by the server.",
    )
    offset: int = Field(
        default=0,
        ge=0,
        description="Zero-based offset for pagination.",
    )


# Map in TOOL_INPUT_MODELS:
# "list_widgets": ListWidgetsInput,


