# 2) registry/tool_registry.py — catalog entry (illustrative)
# ---------------------------------------------------------------------------
# "list_widgets": _spec(
#     "list_widgets",
#     domain="widgets",  # must be a DomainName Literal — extend if new domain
#     operation="read",
#     description=(
#         "List widgets. Returns one page of results. If hasMore is true, call again "
#         "with offset = offset + limit. Does not return quote or pricing data."
#     ),
#     tags={"paginated"},
#     read_only=True,
#     title="List Widgets",
#     version="1.0.0",  # bump when this tool's behavior/schema/description/API changes
#     # icons= omitted → domain default from registry/tool_icons.py
#     http_method="GET",
#     api_path="/widgets",
# ),


# ---------------------------------------------------------------------------
# 3) tools/widgets.py — handler + registration
# ---------------------------------------------------------------------------
def register_widget_tools(mcp: Any, client: CPQClient) -> None:
    def list_widgets(limit: int = 100, offset: int = 0) -> dict[str, Any]:
        # Raise on failure; do not swallow exceptions into ad-hoc dicts.
        params = build_page_params(limit, offset)
        response = client.get("/widgets", params=params)
        return enrich_pagination_hint(response, "list_widgets")

    list_widgets.__doc__ = TOOL_CATALOG["list_widgets"].description
    register_tool(mcp, list_widgets, "list_widgets")


