# ==============================================================================
# Oracle CPQ MCP — safe to commit vs. keep local
# ==============================================================================
# COMMIT:  source code, tests, scripts/mcp-server.*, .cursor/mcp.json.example,
#          .cursor/mcp.json.unix.example, .vscode/mcp.json.example, docs/
# NEVER:   .config/* (credentials, profiles, studio state, archive/) except
#          example.yaml / template/; .prompts/;
#          .venv/; exports/; .cursor/mcp.json
# Legacy flat .env templates live under .config/archive/ (gitignored).
# ==============================================================================

# --- Generated outputs ---
.prompts
.knowledge/
# Customer-specific knowledge (local only; keep CPQBaseKnowledge.md tracked)
knowledge/*
!knowledge/CPQBaseKnowledge.md
exports/
dat/
data/
logs/
*.xlsx
*.xls

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# --- Secrets & credentials (CRITICAL) ---
# Ignore everything under .config/ except committed templates (examples only).
# .config/archive/ (legacy .env templates/backups) stays ignored — do not un-ignore.
.config/*
!.config/example.yaml
!.config/example_fusion.yaml
!.config/template/
!.config/template/**
# Global *.xlsx ignore would hide branded templates — re-include them.
!.config/template/*.xlsx
!.config/template/*.docx
!.config/template/*.pptx
!.config/template/*.md
docs/*.md 
!docs/QUICKSTART.md
!docs/SETUP.md
!docs/STANDARDS.md
!docs/COMMON_PROMPTS.md
!docs/RELEASE_NOTES.md
!docs/TOOL_CATALOG.md
!docs/FEATURES.md
!docs/PRE_COMMIT_REVIEW.md
!docs/FAQ.md
!docs/LIVE_SMOKE_MATRIX.md
!docs/UPGRADE.md

# Local Focalpoint/scratch dumps (never commit)
tmp_*

# API debug logs (DEBUG_MODE) — may contain usernames and business query strings
logs/

# Root or stray env files
.env
.env.local
.env.*.local
*.env.local

# Credential / key material
*.pem
# Local diagnostic with inlined Hunter/Gentex oauth_* (never commit)
utilities/compare_fusion_oauth_token.py
# Throwaway Gentex Sales territories GET stub (Basic Auth — never commit)
utilities/stub_gentex_territories_get.py
*.key
*.p12
*.pfx
credentials.json
secrets/
.secrets/

# Local MCP overrides (may contain CPQ_CONFIRMATION_SECRET or local profile names)
.cursor/mcp.json
.cursor/mcp.local.json
!.cursor/mcp.json.example
!.cursor/mcp.json.unix.example
.agents/mcp_config.json
.vscode/mcp.json

# --- IDE (keep shared team settings; ignore local overrides) ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/mcp.json.example
!.vscode/mcp.json.unix.example
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
# Accidental agent dumps left at repo root (prefer tmp/{profile}/{env}/)
/tmp_*.json
/tmp_*.md
/tmp_*.xlsx
/tmp_*.zip
